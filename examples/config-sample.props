DOKU_CLIENT_ID=BRN-0000-0000000000000
DOKU_SECRET_KEY=your-secret-key
DOKU_PRIVATE_KEY_PATH=./doku-private-key.pem
DOKU_SANDBOX=true
DOKU_BANK=bca
DOKU_PARTNER_SERVICE_ID=   19008
DOKU_CUSTOMER_NUMBER=0812345678
# DGPC: customerNo is just the merchant-assigned prefix digit — DOKU generates the
# rest of the payment code itself. Per-bank prefix (from DOKU dashboard "BIN Rules"):
# BCA=9, BNI=3, Mandiri=0. Do NOT invent a longer customerNo yourself.
DOKU_CUSTOMER_NO_PREFIX=9

# KIRIMDOKU legacy (non-SNAP) API — separate credentials, separate system.
# See docs/KIRIMDOKU_LEGACY_API_REFERENCE.md.
KIRIMDOKU_LEGACY_AGENT_KEY=A00000
KIRIMDOKU_LEGACY_ENCRYPTION_KEY=0123456789abcdef
KIRIMDOKU_LEGACY_SANDBOX=true

# Credit/debit Card product (Payment Page, non-PCI-DSS) — separate credentials,
# separate system from both SNAP and KirimDOKU legacy above. Client-Id namespace
# is "MCH-...", NOT the "BRN-..." one used for DOKU_CLIENT_ID.
DOKU_CARD_CLIENT_ID=MCH-0000-0000000000000
DOKU_CARD_SECRET_KEY=your-card-secret-key
DOKU_CARD_SANDBOX=true
